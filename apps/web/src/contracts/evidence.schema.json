{
  "$defs": {
    "Admission": {
      "additionalProperties": false,
      "properties": {
        "caseFile": {
          "maxLength": 262144,
          "title": "Casefile",
          "type": "string"
        },
        "pairId": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Pairid",
          "type": "string"
        }
      },
      "required": ["caseFile", "pairId"],
      "title": "Admission",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": { "minimum": 0, "title": "Bytes", "type": "integer" },
        "id": { "minLength": 1, "title": "Id", "type": "string" },
        "kind": { "minLength": 1, "title": "Kind", "type": "string" },
        "mediaType": { "minLength": 1, "title": "Mediatype", "type": "string" },
        "path": { "minLength": 1, "title": "Path", "type": "string" },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": ["id", "kind", "path", "mediaType", "sha256", "bytes"],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "chargedBytes": {
          "default": 0,
          "maximum": 67108864,
          "minimum": 0,
          "title": "Chargedbytes",
          "type": "integer"
        },
        "maxArtifactBytes": {
          "const": 67108864,
          "default": 67108864,
          "title": "Maxartifactbytes",
          "type": "integer"
        },
        "maxEvents": {
          "const": 512,
          "default": 512,
          "title": "Maxevents",
          "type": "integer"
        },
        "maxProbes": {
          "const": 4,
          "default": 4,
          "title": "Maxprobes",
          "type": "integer"
        },
        "maxSeconds": {
          "const": 900,
          "default": 900,
          "title": "Maxseconds",
          "type": "integer"
        },
        "reducerCandidates": {
          "const": 0,
          "default": 0,
          "title": "Reducercandidates",
          "type": "integer"
        },
        "reservedProbes": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Reservedprobes",
          "type": "integer"
        }
      },
      "required": [
        "maxProbes",
        "maxSeconds",
        "maxArtifactBytes",
        "maxEvents",
        "reducerCandidates",
        "reservedProbes",
        "chargedBytes"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "classifying": {
          "const": false,
          "default": false,
          "title": "Classifying",
          "type": "boolean"
        },
        "exporting": {
          "const": false,
          "default": false,
          "title": "Exporting",
          "type": "boolean"
        },
        "reducing": {
          "const": false,
          "default": false,
          "title": "Reducing",
          "type": "boolean"
        }
      },
      "required": ["reducing", "classifying", "exporting"],
      "title": "Capabilities",
      "type": "object"
    },
    "CheckObservation": {
      "additionalProperties": false,
      "properties": {
        "name": { "minLength": 1, "title": "Name", "type": "string" },
        "status": {
          "enum": ["result", "error"],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            { "$ref": "#/$defs/Result" },
            { "$ref": "#/$defs/EngineError" }
          ],
          "title": "Value"
        }
      },
      "required": ["name", "status", "value"],
      "title": "CheckObservation",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "admission_seconds": {
          "default": 120,
          "maximum": 120,
          "minimum": 1,
          "title": "Admission Seconds",
          "type": "integer"
        },
        "candidates": {
          "items": { "$ref": "#/$defs/RankedCandidate" },
          "maxItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "created_at": { "title": "Created At", "type": "string" },
        "fingerprint_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint Id",
          "type": "string"
        },
        "investigation_id": { "title": "Investigation Id", "type": "string" },
        "limits": { "$ref": "#/$defs/RunLimits" },
        "novel": { "title": "Novel", "type": "boolean" },
        "outcome": {
          "enum": ["selected", "not_reproduced", "unresolved"],
          "title": "Outcome",
          "type": "string"
        },
        "planner_version": {
          "const": "planner-v1",
          "default": "planner-v1",
          "title": "Planner Version",
          "type": "string"
        },
        "registry_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        },
        "rejections": {
          "items": { "$ref": "#/$defs/Rejection" },
          "maxItems": 202,
          "title": "Rejections",
          "type": "array"
        },
        "scope": { "$ref": "#/$defs/VersionScope" },
        "seed_case_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Seed Case Id",
          "type": "string"
        },
        "seed_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Seed Manifest Sha256",
          "type": "string"
        },
        "selected_probe_id": {
          "anyOf": [
            { "maxLength": 160, "minLength": 1, "type": "string" },
            { "type": "null" }
          ],
          "title": "Selected Probe Id"
        },
        "selection_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Selection Id",
          "type": "string"
        },
        "sequence": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "source_snapshot_ref": { "$ref": "#/$defs/EvidenceReference" },
        "terminal_reason": {
          "anyOf": [
            {
              "enum": ["no_applicable_probe", "budget_exhausted"],
              "type": "string"
            },
            { "type": "null" }
          ],
          "default": null,
          "title": "Terminal Reason"
        },
        "transformed_case_ref": {
          "anyOf": [{ "$ref": "#/$defs/EvidenceReference" }, { "type": "null" }]
        }
      },
      "required": [
        "selection_id",
        "investigation_id",
        "registry_sha256",
        "seed_case_id",
        "fingerprint_id",
        "seed_manifest_sha256",
        "scope",
        "created_at",
        "novel",
        "candidates",
        "rejections",
        "selected_probe_id",
        "outcome",
        "limits",
        "source_snapshot_ref",
        "transformed_case_ref"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Divergence": {
      "additionalProperties": false,
      "properties": {
        "baselineObservationDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Baselineobservationdigest",
          "type": "string"
        },
        "changedDimensions": {
          "items": { "type": "string" },
          "title": "Changeddimensions",
          "type": "array"
        },
        "comparisonVersion": {
          "minLength": 1,
          "title": "Comparisonversion",
          "type": "string"
        },
        "kind": {
          "enum": ["status", "error", "result", "postcondition", "mixed"],
          "title": "Kind",
          "type": "string"
        },
        "signature": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Signature",
          "type": "string"
        },
        "targetObservationDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Targetobservationdigest",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "signature",
        "baselineObservationDigest",
        "targetObservationDigest",
        "changedDimensions",
        "comparisonVersion"
      ],
      "title": "Divergence",
      "type": "object"
    },
    "EngineError": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "PARSE",
            "SEMANTIC",
            "TYPE",
            "CONSTRAINT",
            "RUNTIME",
            "TIMEOUT",
            "CRASH",
            "UNKNOWN"
          ],
          "title": "Category",
          "type": "string"
        },
        "detail": { "maxLength": 16384, "title": "Detail", "type": "string" },
        "normalizedCode": {
          "anyOf": [{ "minLength": 1, "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Normalizedcode"
        }
      },
      "required": ["category", "detail"],
      "title": "EngineError",
      "type": "object"
    },
    "EngineObservation": {
      "additionalProperties": false,
      "properties": {
        "engineVersionId": {
          "minLength": 1,
          "title": "Engineversionid",
          "type": "string"
        },
        "error": {
          "anyOf": [{ "$ref": "#/$defs/EngineError" }, { "type": "null" }],
          "default": null
        },
        "postconditions": {
          "items": { "$ref": "#/$defs/CheckObservation" },
          "title": "Postconditions",
          "type": "array"
        },
        "result": {
          "anyOf": [{ "$ref": "#/$defs/Result" }, { "type": "null" }],
          "default": null
        },
        "status": {
          "enum": ["result", "error", "timeout", "crash"],
          "title": "Status",
          "type": "string"
        },
        "timing": { "$ref": "#/$defs/Timing" }
      },
      "required": ["engineVersionId", "status", "timing"],
      "title": "EngineObservation",
      "type": "object"
    },
    "EnginePair": {
      "additionalProperties": false,
      "properties": {
        "baselineId": {
          "minLength": 1,
          "title": "Baselineid",
          "type": "string"
        },
        "id": { "minLength": 1, "title": "Id", "type": "string" },
        "label": { "minLength": 1, "title": "Label", "type": "string" },
        "targetId": { "minLength": 1, "title": "Targetid", "type": "string" }
      },
      "required": ["id", "label", "baselineId", "targetId"],
      "title": "EnginePair",
      "type": "object"
    },
    "EngineSpec": {
      "additionalProperties": false,
      "properties": {
        "commitSha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Commitsha",
          "type": "string"
        },
        "id": { "minLength": 1, "title": "Id", "type": "string" },
        "imageDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Imagedigest",
          "type": "string"
        },
        "imageRef": { "minLength": 1, "title": "Imageref", "type": "string" },
        "label": { "minLength": 1, "title": "Label", "type": "string" },
        "lineage": {
          "enum": ["legacy-c", "rust"],
          "title": "Lineage",
          "type": "string"
        },
        "repository": {
          "const": "FalkorDB/FalkorDB",
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "repository",
        "commitSha",
        "lineage",
        "imageRef",
        "imageDigest"
      ],
      "title": "EngineSpec",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "at": { "title": "At", "type": "string" },
        "data": { "$ref": "#/$defs/EventData" },
        "id": { "title": "Id", "type": "string" },
        "investigationId": { "title": "Investigationid", "type": "string" },
        "phase": { "$ref": "#/$defs/Status" },
        "sequence": {
          "maximum": 512,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "summary": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "type": {
          "enum": [
            "investigation.created",
            "phase.started",
            "fingerprint.completed",
            "graph.read",
            "probe.candidates",
            "probe.selected",
            "engine.observed",
            "divergence.detected",
            "graph.write",
            "cancellation.requested",
            "investigation.not_reproduced",
            "investigation.unresolved",
            "investigation.cancelled",
            "investigation.failed"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "investigationId",
        "sequence",
        "type",
        "at",
        "phase",
        "summary",
        "data"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventData": {
      "additionalProperties": false,
      "properties": {
        "childId": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Childid"
        },
        "probeSequence": {
          "maximum": 4,
          "minimum": 0,
          "title": "Probesequence",
          "type": "integer"
        },
        "references": {
          "items": { "$ref": "#/$defs/EvidenceReference" },
          "maxItems": 3,
          "title": "References",
          "type": "array"
        },
        "revision": { "minimum": 1, "title": "Revision", "type": "integer" },
        "status": { "$ref": "#/$defs/Status" }
      },
      "required": ["revision", "status", "probeSequence"],
      "title": "EventData",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "anyOf": [
            { "maxLength": 131072, "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Decision"
        },
        "kind": {
          "enum": ["seed", "selection", "result"],
          "title": "Kind",
          "type": "string"
        },
        "observations": {
          "anyOf": [{ "$ref": "#/$defs/PairedSummary" }, { "type": "null" }],
          "default": null
        },
        "query": {
          "anyOf": [
            { "maxLength": 16384, "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Query"
        },
        "references": {
          "items": { "$ref": "#/$defs/EvidenceReference" },
          "maxItems": 10,
          "title": "References",
          "type": "array"
        },
        "sequence": {
          "maximum": 4,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": ["sequence", "kind", "references"],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidencePage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": { "$ref": "#/$defs/EvidenceItem" },
          "maxItems": 25,
          "title": "Items",
          "type": "array"
        },
        "nextCursor": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "title": "Nextcursor"
        },
        "revision": { "title": "Revision", "type": "integer" }
      },
      "required": ["revision", "items", "nextCursor"],
      "title": "EvidencePage",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "bytes": { "minimum": 0, "title": "Bytes", "type": "integer" },
        "id": { "minLength": 1, "title": "Id", "type": "string" },
        "kind": { "minLength": 1, "title": "Kind", "type": "string" },
        "mediaType": { "minLength": 1, "title": "Mediatype", "type": "string" },
        "owner": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "path": { "minLength": 1, "title": "Path", "type": "string" },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "mediaType",
        "sha256",
        "bytes",
        "owner"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "properties": {
        "errorCategory": {
          "anyOf": [
            {
              "enum": [
                "PARSE",
                "SEMANTIC",
                "TYPE",
                "CONSTRAINT",
                "RUNTIME",
                "TIMEOUT",
                "CRASH",
                "UNKNOWN"
              ],
              "type": "string"
            },
            { "type": "null" }
          ],
          "default": null,
          "title": "Errorcategory"
        },
        "kind": {
          "enum": [
            "baseline_matches_expected",
            "explicit_result",
            "explicit_error",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [{ "$ref": "#/$defs/ExpectedResult" }, { "type": "null" }],
          "default": null
        }
      },
      "required": ["kind"],
      "title": "Expectation",
      "type": "object"
    },
    "ExpectedResult": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": { "type": "string" },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": { "$ref": "#/$defs/JsonValue" },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": ["columns", "rows"],
      "title": "ExpectedResult",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "code": { "minLength": 1, "title": "Code", "type": "string" },
        "engineRole": {
          "anyOf": [
            { "enum": ["baseline", "target"], "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Enginerole"
        },
        "message": { "minLength": 1, "title": "Message", "type": "string" },
        "stage": { "minLength": 1, "title": "Stage", "type": "string" }
      },
      "required": ["code", "stage", "message"],
      "title": "Failure",
      "type": "object"
    },
    "FaultCase": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            { "maxLength": 4000, "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Description"
        },
        "expectation": {
          "anyOf": [{ "$ref": "#/$defs/Expectation" }, { "type": "null" }],
          "default": null
        },
        "id": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Id"
        },
        "metadata": {
          "anyOf": [{ "$ref": "#/$defs/Metadata" }, { "type": "null" }],
          "default": null
        },
        "observation": { "$ref": "#/$defs/ObservationSpec" },
        "parameters": {
          "additionalProperties": { "$ref": "#/$defs/JsonValue" },
          "title": "Parameters",
          "type": "object"
        },
        "query": { "minLength": 1, "title": "Query", "type": "string" },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "setup": {
          "items": { "type": "string" },
          "maxItems": 32,
          "title": "Setup",
          "type": "array"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": ["schemaVersion", "title", "setup", "query", "observation"],
      "title": "FaultCase",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "items": { "$ref": "#/$defs/JsonValue" }, "type": "array" },
        {
          "additionalProperties": { "$ref": "#/$defs/JsonValue" },
          "type": "object"
        }
      ]
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "anyOf": [
            { "maxLength": 4000, "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Notes"
        },
        "source": {
          "anyOf": [
            { "maxLength": 4000, "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "ObservationSpec": {
      "additionalProperties": false,
      "properties": {
        "compareResult": { "title": "Compareresult", "type": "boolean" },
        "ordering": {
          "enum": ["auto", "ordered", "unordered"],
          "title": "Ordering",
          "type": "string"
        },
        "postconditions": {
          "items": { "$ref": "#/$defs/StateCheck" },
          "maxItems": 8,
          "title": "Postconditions",
          "type": "array"
        }
      },
      "required": ["compareResult", "ordering"],
      "title": "ObservationSpec",
      "type": "object"
    },
    "ObservationSummary": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": { "type": "string" },
          "maxItems": 32,
          "title": "Columns",
          "type": "array"
        },
        "detail": {
          "anyOf": [{ "maxLength": 256, "type": "string" }, { "type": "null" }],
          "title": "Detail"
        },
        "engineVersionId": { "title": "Engineversionid", "type": "string" },
        "errorCategory": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "title": "Errorcategory"
        },
        "rowCount": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "title": "Rowcount"
        },
        "status": {
          "enum": ["result", "error", "timeout", "crash"],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "engineVersionId",
        "status",
        "rowCount",
        "columns",
        "errorCategory",
        "detail"
      ],
      "title": "ObservationSummary",
      "type": "object"
    },
    "PairedObservation": {
      "additionalProperties": false,
      "properties": {
        "baseline": { "$ref": "#/$defs/EngineObservation" },
        "target": { "$ref": "#/$defs/EngineObservation" }
      },
      "required": ["baseline", "target"],
      "title": "PairedObservation",
      "type": "object"
    },
    "PairedSummary": {
      "additionalProperties": false,
      "properties": {
        "baseline": { "$ref": "#/$defs/ObservationSummary" },
        "target": { "$ref": "#/$defs/ObservationSummary" }
      },
      "required": ["baseline", "target"],
      "title": "PairedSummary",
      "type": "object"
    },
    "ProbeEligibility": {
      "additionalProperties": false,
      "properties": {
        "applicable": { "title": "Applicable", "type": "boolean" },
        "input_case_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Case Id",
          "type": "string"
        },
        "output_case_id": {
          "anyOf": [
            { "pattern": "^[a-f0-9]{64}$", "type": "string" },
            { "type": "null" }
          ],
