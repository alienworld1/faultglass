{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build:showcase",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api(?:/.*)?", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
