[Unit]
Description=FaultGlass singleton investigator
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=exec
User=faultglass
Group=faultglass
SupplementaryGroups=docker
WorkingDirectory=/opt/faultglass/apps/investigator
EnvironmentFile=/etc/faultglass/runtime.env
EnvironmentFile=/etc/faultglass/worker.env
ExecStartPre=/opt/faultglass/apps/investigator/.venv/bin/python -m faultglass.preflight --bootstrap --worker
ExecStart=/opt/faultglass/apps/investigator/.venv/bin/python -m faultglass.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
MemoryMax=1G
MemorySwapMax=0
CPUQuota=100%
TasksMax=128
LimitNOFILE=1024
LogNamespace=faultglass-worker

[Install]
WantedBy=multi-user.target
